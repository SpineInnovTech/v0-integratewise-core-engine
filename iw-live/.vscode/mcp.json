{
  "servers": {
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github_token}"
      }
    },
    "microsoft/playwright-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "gallery": "https://api.mcp.github.com",
      "version": "0.0.1-seed"
    },
    "io.github.github/github-mcp-server": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN=${input:github_token}",
        "ghcr.io/github/github-mcp-server:0.30.3"
      ],
      "gallery": "https://api.mcp.github.com",
      "version": "0.30.3"
    },
    "integratewise": {
      "url": "https://mcp.integratewise.ai/mcp"
    },
    "integratewise-cloud": {
      "type": "stdio",
      "command": "node",
      "args": ["scripts/integratewise-mcp-bridge.mjs"],
      "env": {
        "INTEGRATEWISE_MCP_URL": "${input:integratewise_mcp_url}",
        "INTEGRATEWISE_MCP_TOKEN": "${input:integratewise_mcp_token}",
        "INTEGRATEWISE_TENANT_ID": "${input:integratewise_tenant_id}"
      }
    },
    "cloudflare": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cloudflare/mcp-server-cloudflare", "run", "${input:cloudflare_account_id}"]
    }
  },
  "inputs": [
    {
      "id": "github_token",
      "type": "promptString",
      "description": "GitHub Personal Access Token",
      "password": true
    },
    {
      "id": "token",
      "type": "promptString",
      "description": "",
      "password": true
    },
    {
      "id": "integratewise_mcp_url",
      "type": "promptString",
      "description": "IntegrateWise MCP base URL (default: https://gateway.integratewise.ai/api/v1/connector)",
      "default": "https://mcp.integratewise.ai"
    },
    {
      "id": "integratewise_mcp_token",
      "type": "promptString",
      "description": "IntegrateWise JWT or MCP key (Bearer token)",
      "password": true
    },
    {
      "id": "integratewise_tenant_id",
      "type": "promptString",
      "description": "IntegrateWise tenant ID for tool invocation"
    },
    {
      "id": "cloudflare_account_id",
      "type": "promptString",
      "description": "Cloudflare account ID (Dashboard → Workers & Pages → right sidebar, or run: npx wrangler whoami)",
      "default": "a1bbbb12a32cdbb68dd170b09fe8b5f3"
    }
  ]
}
