{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm: format",
      "type": "shell",
      "command": "pnpm run format",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "pnpm: format check",
      "type": "shell",
      "command": "pnpm run format:check",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "pnpm: lint",
      "type": "shell",
      "command": "pnpm run lint",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "pnpm: typecheck",
      "type": "shell",
      "command": "pnpm run typecheck",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "pnpm: dev (web)",
      "type": "shell",
      "command": "pnpm --filter @integratewise/web dev",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "pnpm: build",
      "type": "shell",
      "command": "pnpm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "pnpm: preview (web)",
      "type": "shell",
      "command": "pnpm --filter @integratewise/web preview",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "pnpm: test e2e (web)",
      "type": "shell",
      "command": "pnpm --filter @integratewise/web test:e2e",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "pnpm: lefthook install",
      "type": "shell",
      "command": "lefthook install",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "none",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "pnpm: preflight (lint + typecheck + test + build)",
      "type": "shell",
      "command": "pnpm run preflight",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always" }
    }
  ]
}
