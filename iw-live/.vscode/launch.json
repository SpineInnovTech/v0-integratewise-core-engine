{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web app (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/web/src",
      "sourceMaps": true
    },
    {
      "name": "Web app (Chrome) — with backend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/apps/web/src",
      "sourceMaps": true,
      "preLaunchTask": "pnpm: dev (web)"
    },
    {
      "name": "Playwright: debug current test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/web/node_modules/.bin/playwright",
      "args": ["test", "--debug"],
      "cwd": "${workspaceFolder}/apps/web",
      "console": "integratedTerminal"
    }
  ]
}
