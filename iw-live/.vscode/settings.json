{
  "window.autoDetectColorScheme": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    ".mule": true,
    "**/.wrangler": true,
    "**/dist": true,
    "**/coverage": true
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.wrangler": true,
    "**/coverage": true,
    "**/pnpm-lock.yaml": true
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "notebook.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "files.autoSave": "afterDelay",
  "editor.experimental.asyncTokenizationVerification": true,
  "editor.experimental.preferTreeSitter.ini": true,
  "editor.experimental.preferTreeSitter.regex": true,
  "editor.experimental.treeSitterTelemetry": true,
  "editor.experimentalGpuAcceleration": "on",
  "editor.foldingImportsByDefault": true,
  "diffEditor.codeLens": true,
  "diffEditor.experimental.showMoves": true,
  "editor.minimap.autohide": "mouseover",
  "editor.minimap.enabled": true,
  "editor.codeActions.triggerOnFocusChange": true,
  "editor.codeLensFontSize": 12,
  "accessibility.signals.lineHasFoldedArea": {
    "sound": "on"
  },
  "explorer.fileNesting.enabled": true,
  "scm.alwaysShowActions": true,
  "scm.alwaysShowRepositories": true,
  "composer.workingPath": "",
  "gitHistory.includeRemoteBranches": true,
  "git.supportCancellation": false,
  "terminal.integrated.env.osx": {
    "OPENROUTER_API_KEY": "${env:OPENROUTER_API_KEY}",
    "SUPABASE_URL": "${env:SUPABASE_URL}",
    "SUPABASE_SERVICE_ROLE_KEY": "${env:SUPABASE_SERVICE_ROLE_KEY}",
    "SUPABASE_SERVICE_KEY": "${env:SUPABASE_SERVICE_KEY}",
    "VITE_API_BASE_URL": "${env:VITE_API_BASE_URL}",
    "VITE_SUPABASE_URL": "${env:VITE_SUPABASE_URL}",
    "VITE_SUPABASE_ANON_KEY": "${env:VITE_SUPABASE_ANON_KEY}"
  },
  "terminal.integrated.env.linux": {
    "OPENROUTER_API_KEY": "${env:OPENROUTER_API_KEY}",
    "SUPABASE_URL": "${env:SUPABASE_URL}",
    "SUPABASE_SERVICE_ROLE_KEY": "${env:SUPABASE_SERVICE_ROLE_KEY}",
    "SUPABASE_SERVICE_KEY": "${env:SUPABASE_SERVICE_KEY}",
    "VITE_API_BASE_URL": "${env:VITE_API_BASE_URL}",
    "VITE_SUPABASE_URL": "${env:VITE_SUPABASE_URL}",
    "VITE_SUPABASE_ANON_KEY": "${env:VITE_SUPABASE_ANON_KEY}"
  },
  "terminal.integrated.env.windows": {
    "OPENROUTER_API_KEY": "${env:OPENROUTER_API_KEY}",
    "SUPABASE_URL": "${env:SUPABASE_URL}",
    "SUPABASE_SERVICE_ROLE_KEY": "${env:SUPABASE_SERVICE_ROLE_KEY}",
    "SUPABASE_SERVICE_KEY": "${env:SUPABASE_SERVICE_KEY}",
    "VITE_API_BASE_URL": "${env:VITE_API_BASE_URL}",
    "VITE_SUPABASE_URL": "${env:VITE_SUPABASE_URL}",
    "VITE_SUPABASE_ANON_KEY": "${env:VITE_SUPABASE_ANON_KEY}"
  },
  "cursorpyright.nodeEnvVars": {},
  "python.terminal.useEnvFile": true,
  "rest-client.environmentVariables": {
    "$shared": {}
  },
  "vitest.disabledWorkspaceFolders": [],
  "editor.suggest.preview": true,
  "markdown.preview.linkify": false,
  "rest-client.previewResponseInUntitledDocument": true,
  "markdown.preview.breaks": true,
  "kiroAgent.notifications.agent.success": true,
  "kiroAgent.agentAutonomy": "Autopilot",
  "kiroAgent.enableCodebaseIndexing": true,
  "kiroAgent.enableDebugLogs": true,
  "kiroAgent.enableTabAutocomplete": true
}
