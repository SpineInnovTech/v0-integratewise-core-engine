{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "../../",
    "types": ["@cloudflare/workers-types"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "../loader/src/**/*.ts",
    "../mcp-connector/src/**/*.ts",
    "../store/src/**/*.ts",
    "../../packages/types/src/adaptive-schema.ts",
    "../../packages/types/src/success-schema.ts",
    "../../packages/types/src/schema.ts",
    "../../packages/coda-pack/template.ts",
    "../../packages/coda-pack/templates.ts",
    "../../packages/coda-pack/infisical.ts",
    "../gateway/src/lib/jwt.ts"
  ],
  "exclude": ["**/*.test.ts", "node_modules", "dist"]
}
