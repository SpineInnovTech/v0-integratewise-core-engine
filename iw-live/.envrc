# App Development Runtime — IntegrateWise Live Monorepo
use mise

# Python venv (managed by uv/mise)
if [ -d .venv ]; then
  source .venv/bin/activate
fi

# Repo-local Node tooling
export PATH="$PWD/node_modules/.bin:$PATH"

# Per-repo env
dotenv_if_exists .env.local
dotenv_if_exists .env

# Repo identity
export REPO_NAME="integratewise-live"
