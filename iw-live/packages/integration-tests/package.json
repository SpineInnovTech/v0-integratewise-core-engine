{
  "name": "@integratewise/integration-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:flow-a": "vitest run --testNamePattern='Flow A'",
    "test:flow-b": "vitest run --testNamePattern='Flow B'",
    "test:flow-c": "vitest run --testNamePattern='Flow C'",
    "test:integration": "vitest run --testNamePattern='Cross-Flow'",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "vitest": "^1.2.1",
    "@integratewise/connector-contracts": "workspace:*",
    "@integratewise/connector-utils": "workspace:*",
    "typescript": "^5.0.0"
  }
}
