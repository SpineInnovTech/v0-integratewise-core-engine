# IntegrateWise — local development environment variables
# Copy to .env and set values. Do not commit .env (gitignored).
# Workers: copy needed vars to services/<name>/.dev.vars for wrangler dev.
# Web app: copy VITE_* to apps/web/.env.local (Vite loads from app dir).

# =============================================================================
# Cloudflare (Wrangler deploy + Secrets Store; optional if you use wrangler login)
# =============================================================================
# Required for: wrangler deploy, wrangler secrets-store *, deploy scripts.
# Get account ID: Dashboard → Workers & Pages → right sidebar, or
#   https://dash.cloudflare.com → any product → URL has account id.
# Get API token: My Profile → API Tokens → Create Token (e.g. "Edit Cloudflare Workers").
# Alternative: run `pnpm exec wrangler login` and omit these (browser OAuth).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# =============================================================================
# Supabase (shared: web app auth + Workers that call Supabase)
# =============================================================================
# Get from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Some Workers use SERVICE_ROLE_KEY, Think/Store/Billing use SERVICE_KEY — set both to same value
SUPABASE_SERVICE_KEY=

# =============================================================================
# Web app (apps/web) — use in apps/web/.env.local for Vite
# =============================================================================
VITE_API_BASE_URL=http://localhost:8786
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional: if you use a Supabase Edge Function to provision tenants/users on signup,
# set this to the function path (e.g. "signup"). When unset, the app uses
# supabase.auth.signUp() directly.
# VITE_SUPABASE_SIGNUP_FUNCTION=signup
# Optional
# VITE_STREAM_URL=http://localhost:8786
# VITE_DEMO_AUTH=false
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_MIXPANEL_TOKEN=

# =============================================================================
# OpenRouter (Think, Knowledge, OpenRouter SDK)
# =============================================================================
OPENROUTER_API_KEY=

# Optional OpenRouter tuning
# OPENROUTER_SITE_URL=https://app.integratewise.ai
# OPENROUTER_SITE_NAME=IntegrateWise
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# =============================================================================
# Optional — only if you run the relevant service locally
# =============================================================================
# Gateway / webhook verification
# GITHUB_WEBHOOK_SECRET=

# MCP connector (for session capture / tools)
# MCP_CONNECTOR_API_KEY=
# MCP_SERVER_URL=https://gateway.integratewise.ai/api/v1/connector

# Tenants (OAuth)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

Figma_Client_ID=your-figma-client-id-here
Figma_Client_Secret=your-figma-client-secret-here