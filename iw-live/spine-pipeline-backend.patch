+async function decryptToken(ciphertext: string, encryptionKey?: string): Promise<string> {
+  if (!encryptionKey || !ciphertext) return ciphertext;
+  if (!ciphertext.startsWith("enc:")) return ciphertext; // Not encrypted
+  const key = await deriveKey(encryptionKey);
+  const raw = ciphertext.slice(4); // Remove "enc:" prefix
+  const combined = Uint8Array.from(atob(raw), (c) => c.charCodeAt(0));
+  const iv = combined.slice(0, 12);
+  const data = combined.slice(12);
+  const decrypted = await crypto.subtle.decrypt({ name: "AES-GCM", iv }, key, data);
+  return new TextDecoder().decode(decrypted);
+}
+
+/**
+ * Refresh an expired OAuth access token using the stored refresh token.
+ * Returns the new access token or null if refresh fails.
+ */
+async function refreshAccessToken(
+  env: Env,
+  provider: string,
+  tenantId: string,
+  userId: string
+): Promise<string | null> {
+  const sql = neon(env.DATABASE_URL);
+
+  // Read the connector record
+  const rows = await sql`
+    SELECT access_token, refresh_token, expires_at, provider_workspace_id, tokens_encrypted
+    FROM connectors
+    WHERE tenant_id = ${tenantId} AND user_id = ${userId} AND provider = ${provider}
+    LIMIT 1
+  `;
+
+  if (!rows.length) return null;
+  const row = rows[0] as any;
+
+  if (!row.refresh_token) {
+    console.warn(`[Tenants] No refresh token for ${provider} (tenant: ${tenantId})`);
+    return null;
+  }
+
+  // Decrypt the refresh token
+  const refreshToken = row.tokens_encrypted
+    ? await decryptToken(row.refresh_token, env.TOKEN_ENCRYPTION_KEY)
+    : row.refresh_token;
+
+  // Look up the OAuth config for this provider
+  const oauthConfig = OAUTH_REGISTRY[provider];
+  if (!oauthConfig || !oauthConfig.endpoints?.token) {
+    console.warn(`[Tenants] No OAuth config for ${provider}, cannot refresh`);
+    return null;
+  }
+
+  // Exchange refresh token for new access token
+  const clientIdKey = `${provider.toUpperCase().replace(/-/g, "_")}_CLIENT_ID`;
+  const clientSecretKey = `${provider.toUpperCase().replace(/-/g, "_")}_CLIENT_SECRET`;
+  const params = new URLSearchParams({
+    grant_type: "refresh_token",
+    refresh_token: refreshToken,
+    client_id: (env as any)[clientIdKey] || "",
+    client_secret: (env as any)[clientSecretKey] || "",
+  });
+
+  try {
+    const tokenRes = await fetch(oauthConfig.endpoints.token, {
+      method: "POST",
+      headers: { "Content-Type": "application/x-www-form-urlencoded" },
+      body: params.toString(),
+    });
+
+    if (!tokenRes.ok) {
+      const errBody = await tokenRes.text().catch(() => "");
+      console.error(
+        `[Tenants] Token refresh failed for ${provider}: ${tokenRes.status} ${errBody}`
+      );
+      return null;
+    }
+
+    const tokens: any = await tokenRes.json();
+    const newAccessToken = tokens.access_token;
+    const newRefreshToken = tokens.refresh_token || refreshToken; // Some providers rotate refresh tokens
+    const newExpiresIn = tokens.expires_in ? Number(tokens.expires_in) : null;
+    const newExpiresAt = newExpiresIn
+      ? new Date(Date.now() + newExpiresIn * 1000).toISOString()
+      : null;
+
+    // Encrypt and store the new tokens
+    const encryptedAccess = await encryptToken(newAccessToken, env.TOKEN_ENCRYPTION_KEY);
+    const encryptedRefresh =
+      newRefreshToken !== refreshToken
+        ? await encryptToken(newRefreshToken, env.TOKEN_ENCRYPTION_KEY)
+        : row.refresh_token; // Keep existing encrypted value if not rotated
+
+    await sql`
+      UPDATE connectors
+      SET access_token = ${encryptedAccess},
+          refresh_token = ${encryptedRefresh},
+          expires_at = ${newExpiresAt},
+          metadata = metadata || ${JSON.stringify({ last_refreshed_at: new Date().toISOString() })}::jsonb
+      WHERE tenant_id = ${tenantId} AND user_id = ${userId} AND provider = ${provider}
+    `;
+
+    console.log(`[Tenants] Token refreshed for ${provider} (tenant: ${tenantId})`);
+    return newAccessToken;
+  } catch (err: any) {
+    console.error(`[Tenants] Token refresh error for ${provider}:`, err.message);
+    return null;
+  }
+}
+
+/**
+ * Get a valid (non-expired) access token for a connector.
+ * If the token is expired and a refresh token exists, refreshes it automatically.
+ * Returns the decrypted access token or null if unavailable.
+ */
+async function getValidConnectorToken(
+  env: Env,
+  provider: string,
+  tenantId: string,
+  userId: string
+): Promise<string | null> {
+  const sql = neon(env.DATABASE_URL);
+
+  const rows = await sql`
+    SELECT access_token, refresh_token, expires_at, tokens_encrypted, status
+    FROM connectors
+    WHERE tenant_id = ${tenantId} AND user_id = ${userId} AND provider = ${provider} AND status = 'connected'
+    LIMIT 1
+  `;
+
+  if (!rows.length) return null;
+  const row = rows[0] as any;
+
+  if (!row.access_token) return null;
+
+  // Check if token is expired (with 5-minute buffer)
+  const isExpired =
+    row.expires_at && new Date(row.expires_at).getTime() < Date.now() + 5 * 60 * 1000;
+
+  if (isExpired && row.refresh_token) {
+    // Attempt refresh
+    const refreshed = await refreshAccessToken(env, provider, tenantId, userId);
+    if (refreshed) return refreshed;
+    // If refresh fails, try the existing token anyway (it might still work for a few seconds)
+  }
+
+  // Decrypt and return the current token
+  return row.tokens_encrypted
+    ? decryptToken(row.access_token, env.TOKEN_ENCRYPTION_KEY)
+    : row.access_token;
+}
