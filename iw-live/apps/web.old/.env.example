# IntegrateWise Environment Configuration
# Copy to .env.local for local development

# API Gateway
VITE_API_BASE_URL=http://localhost:8786

# Spine Substrate (Configurable Provider DB)
VITE_SPINE_URL=https://your-project.supabase.co
VITE_SPINE_ANON_KEY=your-anon-key

# Active Provider: "spine-db" | "gateway-proxy" | "local-mock"
# Default is "spine-db" if unset.
VITE_SPINE_PROVIDER=spine-db

# Optional: if you use a Spine Edge Function to provision tenants/users on signup,
# set this to the function path (e.g. "signup"). When unset, the app uses
# spineClient.auth.signUp() directly.
# VITE_SPINE_SIGNUP_FUNCTION=signup

# Stream (SSE/WebSocket) — defaults to API_BASE_URL if not set
# VITE_STREAM_URL=http://localhost:8786

# Nango for connectors (use nango dev for local: http://localhost:3003 )
# For real: leave unset (defaults to https://api.nango.dev in backend)
# VITE_NANGO_HOST=http://localhost:3003
